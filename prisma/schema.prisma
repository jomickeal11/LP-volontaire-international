datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CandidateStatus {
  NEW
  REVIEW
  SELECTED
  INTERVIEW
  CHOSEN
  PARTNER_VALIDATION
  PREPARATION
  ARRIVED
  COMPLETED
  REJECTED
  ARCHIVED
}

enum ExperienceDuration {
  LESS_THAN_1_YEAR
  ONE_TO_TWO_YEARS
  TWO_TO_FIVE_YEARS
  FIVE_PLUS_YEARS
}

enum MissionDuration {
  SIX_MONTHS
  NINE_MONTHS
  TWELVE_MONTHS
}

enum LanguageCode {
  FR
  EN
  DE
}

enum DocumentType {
  CV
  MOTIVATION_LETTER
  PORTFOLIO
  PASSPORT
  VISA
}

// ─── 1. CANDIDATS (Profil persistant) ─────────────────────────────────────────
model Candidat {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  country     String
  city        String?
  dateOfBirth DateTime

  // Relations
  applications Candidature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([country])
}

// ─── 2. CANDIDATURES (Applications aux missions) ──────────────────────────────
model Candidature {
  id              String   @id @default(cuid())
  referenceNumber String   @unique // Ex: CAND-2026-XXXX
  candidateId     String
  candidate       Candidat @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status CandidateStatus @default(NEW)
  lang   LanguageCode    @default(FR)
  communicationLanguage LanguageCode @default(FR)

  // Profil académique & professionnel
  education         String
  fieldOfStudy      String
  profession        String
  experienceLevel   ExperienceDuration
  digitalSkillLevel String
  languages         String?            @default("{}")

  // Disponibilité & Mission
  arrivalDate DateTime
  duration    MissionDuration @default(SIX_MONTHS)

  // Motivation & Expérience projet
  motivation        String  @db.Text
  projectExperience String? @db.Text

  // Source & Consentement RGPD
  source      String?
  consentData Boolean @default(false)

  // Attribution UTM first-touch (indépendante du consentement Analytics)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Relations
  skills        CompetenceCandidature[]
  documents     DocumentCandidature[]
  notes         NoteCandidature[]
  statusHistory HistoriqueCandidature[]
  emailLogs     EmailLog[]

  assignedToId String?
  assignedTo   Utilisateur? @relation("AssignedApplications", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([candidateId])
  @@index([referenceNumber])
}

// ─── 3. COMPÉTENCES (Skills normalisés) ───────────────────────────────────────
model Competence {
  id           String                  @id @default(cuid())
  slug         String                  @unique
  nameFr       String
  nameEn       String
  nameDe       String
  category     String // IT, AGRICULTURE, CREATIVE, ENGINEERING
  applications CompetenceCandidature[]
}

model CompetenceCandidature {
  applicationId String
  skillId       String
  application   Candidature @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  skill         Competence  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([applicationId, skillId])
}

// ─── 4. DOCUMENTS (Métadonnées de stockage sécurisé) ──────────────────────────
model DocumentCandidature {
  id            String      @id @default(cuid())
  applicationId String
  application   Candidature @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type         DocumentType @default(CV)
  originalName String
  storageKey   String // Clé de stockage objet privé (ex: s3://apticr-docs/...)
  fileUrl      String? // URL signée temporaire
  mimeType     String
  size         Int // Taille en octets

  createdAt DateTime @default(now())
}

// ─── 5. HISTORIQUE DES STATUTS (Audit Trail) ──────────────────────────────────
model HistoriqueCandidature {
  id            String      @id @default(cuid())
  applicationId String
  application   Candidature @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus    CandidateStatus
  toStatus      CandidateStatus
  changedById   String?
  changedBy     Utilisateur?    @relation(fields: [changedById], references: [id])
  changedByName String          @default("Système")
  note          String?         @db.Text
  changedAt     DateTime        @default(now())

  @@index([applicationId])
}

// ─── 5 BIS. JOURNAL DES EMAILS (Audit Trail & Réessai) ────────────────────────
model EmailLog {
  id            String           @id @default(cuid())
  applicationId String?
  application   Candidature?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Journal transverse : couvre aussi les demandes de participation aux
  // événements, qui ne passent pas par une candidature.
  eventParticipationRequestId String?
  eventParticipationRequest   DemandeParticipation? @relation(fields: [eventParticipationRequestId], references: [id], onDelete: Cascade)

  recipient     String
  recipientName String?
  subject       String
  bodyHtml      String           @db.Text
  bodyText      String?          @db.Text
  status        String           @default("SENT") // "SENT" | "FAILED"
  error         String?          @db.Text

  actionType    String           // "APPLICATION_CONFIRMATION" | "STATUS_CHANGE" | "INTERVIEW_INVITATION" | "DIRECT_EMAIL" | "PARTNER_CONFIRMATION" | "CONTACT_NOTIFICATION" | "EVENT_PARTICIPATION_REQUEST" | "EVENT_PARTICIPATION_DECISION"
  // Volontairement laissés à null pour les emails d'événements : widened le type
  // en texte ferait recréer la colonne par Prisma et perdrait l'historique des
  // candidatures. Le statut de la demande voyage dans `metadata`.
  fromStatus    CandidateStatus?
  toStatus      CandidateStatus?
  templateKey   String?
  metadata      Json?

  sentAt        DateTime         @default(now())

  @@index([applicationId])
  @@index([eventParticipationRequestId])
  @@index([recipient])
  @@index([status])
  @@index([sentAt])
}

// ─── 6. NOTES INTERNES ÉQUIPE ────────────────────────────────────────────────
model NoteCandidature {
  id            String      @id @default(cuid())
  applicationId String
  application   Candidature @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  authorId   String?
  author     Utilisateur? @relation(fields: [authorId], references: [id])
  authorName String       @default("Admin APTIC-R")
  content    String       @db.Text
  createdAt  DateTime     @default(now())

  @@index([applicationId])
}

// ─── 7. PARTENAIRES & DEMANDES ORGANISATIONS ─────────────────────────────────
model Partenaire {
  id        String               @id @default(cuid())
  orgName   String
  country   String
  website   String?
  orgType   String // NGO, University, Government Agency, Foundation
  requests  DemandePartenariat[]
  documents DocumentPartenaire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgName])
  @@index([country])
}

model DemandePartenariat {
  id              String      @id @default(cuid())
  referenceNumber String?     @unique // Ex: PART-2026-XXXX
  partnerId       String?
  partner         Partenaire? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  lang                  LanguageCode @default(FR)
  communicationLanguage LanguageCode @default(FR)

  // Informations organisation
  orgName   String
  country   String
  website   String?
  orgType   String // NGO / Association, University, Government agency, European programme body, etc.

  // Informations contact
  contactPerson   String
  email           String
  phone           String?

  // Programme & Partenariat
  volunteerCount  String?
  targetCountries String?
  programme       String?
  message         String  @db.Text
  consent         Boolean @default(false)
  status          String  @default("PENDING") // PENDING, REVIEW, CONTACTED, PARTNER, ARCHIVED

  // Attribution UTM first-touch (indépendante du consentement Analytics)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  documents DocumentPartenaire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgName])
  @@index([email])
  @@index([status])
}

model DocumentPartenaire {
  id               String              @id @default(cuid())
  partnerId        String?
  partner          Partenaire?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerRequestId String?
  partnerRequest   DemandePartenariat? @relation(fields: [partnerRequestId], references: [id], onDelete: Cascade)

  originalName String
  storageKey   String
  fileUrl      String?
  mimeType     String
  size         Int

  createdAt DateTime @default(now())
}

// ─── 8. UTILISATEURS & ADMINISTRATEURS ────────────────────────────────────────
model Utilisateur {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         String @default("ADMIN") // SUPERADMIN, ADMIN, COORDINATOR, REVIEWER, EDITOR, CONTENT_MANAGER
  active       Boolean @default(true)
  sessionVersion Int @default(0)
  emailChangeRequest ChangementEmailUtilisateur?
  passwordResetRequest ReinitialisationMotDePasse?

  assignedApplications Candidature[]           @relation("AssignedApplications")
  statusChanges        HistoriqueCandidature[]
  notes                NoteCandidature[]
  authoredArticles     Article[]               @relation("ArticleAuthor")
  projectProposalNotes DocumentPropositionNote[]
  projectProposalStatusChanges HistoriquePropositionProjet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvitationAdministrateur {
  id          String   @id @default(cuid())
  name        String
  email       String
  role        String
  tokenHash   String   @unique
  expiresAt   DateTime
  status      String   @default("PENDING") // PENDING | SENT | FAILED | ACCEPTED | INVALIDATED
  createdById String
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email, status])
  @@index([expiresAt])
}

model ChangementEmailUtilisateur {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail      String      @unique
  tokenHash     String      @unique
  expiresAt     DateTime
  status        String      @default("PENDING") // PENDING | SENT | FAILED | CONFIRMING
  lastAttemptAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([expiresAt])
}

model ReinitialisationMotDePasse {
  id        String      @id @default(cuid())
  userId    String      @unique
  user      Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  expiresAt DateTime
  status    String      @default("PENDING") // PENDING | SENT | FAILED | USED
  lastAttemptAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([expiresAt])
}

// ─── 9. ANALYTICS & EVENEMENTS FUNNEL ─────────────────────────────────────────
model EvenementStatistique {
  id        String   @id @default(cuid())
  name      String // apply_now_click, application_started, application_submitted, etc.
  lang      String?
  country   String?
  source    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
}

// ─── 10. DOMAINES D'INTERVENTION INSTITUTIONNELS ──────────────────────────────
model Domaine {
  id               String      @id @default(cuid())
  slug             String      @unique
  code             String      @unique // INCLUSION_NUMERIQUE, JEUNESSE, CYBERSECURITE, AGRI_LOWTECH, DATA_INNOVATION, DEV_RURAL
  
  // Titres & sous-titres
  nameFr           String
  nameEn           String?
  nameDe           String?
  subtitleFr       String?
  subtitleEn       String?
  subtitleDe       String?
  
  // Surtitre / Tag
  tagLabel         String?     @default("Pôle Stratégique")
  
  // Descriptions
  descFr           String      @db.Text
  descEn           String?     @db.Text
  descDe           String?     @db.Text
  
  // Listes à puces (JSON string ou texte)
  objectivesFr     String?     @db.Text
  objectivesEn     String?     @db.Text
  objectivesDe     String?     @db.Text
  actionsFr        String?     @db.Text
  actionsEn        String?     @db.Text
  actionsDe        String?     @db.Text
  
  // Publics cibles
  targetAudienceFr String?     @db.Text
  targetAudienceEn String?     @db.Text
  targetAudienceDe String?     @db.Text
  
  // Médias
  icon             String?
  color            String?
  imageUrl         String?
  imageCaptionFr   String?
  imageCaptionEn   String?
  imageCaptionDe   String?
  imageTag         String?     @default("Ancrage Terrain")
  
  order            Int         @default(0)
  active           Boolean     @default(true)

  projets          Projet[]
  ressources       Ressource[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([order])
  @@index([active])
}

// ─── 11. MEMBRES & DEMANDES D'ADHÉSION ──────────────────────────────────────
model DemandeAdhesion {
  id                String    @id @default(cuid())
  referenceNumber   String    @unique // Ex: ADH-2026-XXXX
  lang              LanguageCode @default(FR)
  firstName         String
  lastName          String
  email             String
  phone             String?
  profession        String?
  organization      String?
  country           String
  city              String?
  domainsOfInterest String    // JSON string array
  contributionType  String    // COMPETENCES, FINANCIER, VOLONTARIAT, RESEAU, AUTRE
  availability      String    // HEBDOMADAIRE, MENSUEL, PONCTUEL, TEMPS_PLEIN
  motivation        String    @db.Text
  consentData       Boolean   @default(false)
  status            String    @default("PENDING") // PENDING (En attente), APPROVED (Validée), REJECTED (Refusée)
  notes             String?   @db.Text

  memberId          String?
  member            Membre?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  history           HistoriqueAdhesion[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([email])
  @@index([country])
  @@index([createdAt])
}

model Membre {
  id                String    @id @default(cuid())
  referenceNumber   String    @unique // Ex: MBR-2026-XXXX
  firstName         String
  lastName          String
  email             String
  phone             String?
  profession        String?
  organization      String?
  country           String
  city              String?
  domainsOfInterest String    // JSON string array
  contributionType  String    // COMPETENCES, FINANCIER, VOLONTARIAT, RESEAU, AUTRE
  availability      String    // HEBDOMADAIRE, MENSUEL, PONCTUEL, TEMPS_PLEIN
  motivation        String    @db.Text
  membershipStatus  String    @default("ACTIVE") // Statut d'adhésion : "ACTIVE" ("Actif")
  membershipDate    DateTime  @default(now())
  notes             String?   @db.Text

  applications      DemandeAdhesion[]
  history           HistoriqueAdhesion[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([membershipStatus])
  @@index([email])
  @@index([country])
}

model HistoriqueAdhesion {
  id            String           @id @default(cuid())
  applicationId String?
  application   DemandeAdhesion? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  memberId      String?
  member        Membre?          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  action        String           // APPLICATION_SUBMITTED, APPLICATION_APPROVED, APPLICATION_REJECTED, APPLICATION_PENDING, MEMBER_CREATED, MEMBER_ACTIVATED, STATUS_CHANGED
  fromStatus    String?
  toStatus      String?
  authorName    String           @default("Admin APTIC-R")
  authorId      String?
  note          String?          @db.Text
  createdAt     DateTime         @default(now())

  @@index([applicationId])
  @@index([memberId])
  @@index([createdAt])
}

// ─── 12. CMS : CATÉGORIES D'ARTICLES ──────────────────────────────────────────
model CategorieArticle {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameFr    String
  nameEn    String
  nameDe    String
  order     Int       @default(0)

  articles  Article[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([order])
}

// ─── 13. CMS : ARTICLES / ACTUALITÉS / BLOG ──────────────────────────────────
model Article {
  id             String            @id @default(cuid())
  slug           String            @unique
  titleFr        String
  titleEn        String?
  titleDe        String?
  excerptFr      String            @db.Text
  excerptEn      String?           @db.Text
  excerptDe      String?           @db.Text
  contentFr      String            @db.Text
  contentEn      String?           @db.Text
  contentDe      String?           @db.Text
  featuredImage  String?
  published      Boolean           @default(false) // legacy aggregate flag, kept for compatibility
  publishedFr    Boolean           @default(false)
  publishedEn    Boolean           @default(false)
  publishedDe    Boolean           @default(false)
  publishedAt    DateTime?

  categoryId     String?
  category       CategorieArticle? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId       String?
  author         Utilisateur?      @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String?

  metaTitle      String?
  metaDescription String?
  tags           String?           // JSON string array
  readingTime    Int               @default(3)
  viewsCount     Int               @default(0)

  isFeatured     Boolean           @default(false)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([published])
  @@index([publishedFr])
  @@index([publishedEn])
  @@index([publishedDe])
  @@index([isFeatured])
  @@index([slug])
  @@index([publishedAt])
  @@index([categoryId])
}

// ─── 14. CMS : PROJETS INSTITUTIONNELS ────────────────────────────────────────
model Projet {
  id            String    @id @default(cuid())
  slug          String    @unique
  sourceProposalId String?             @unique
  sourceProposal   PropositionProjet?  @relation(fields: [sourceProposalId], references: [id], onDelete: SetNull)

  // Publication distincte par langue (stricte étanchéité multilingue)
  publishedFr   Boolean   @default(true)
  publishedEn   Boolean   @default(false)
  publishedDe   Boolean   @default(false)

  // Statut opérationnel sur le terrain (distinct de la publication)
  status        String    @default("IN_PROGRESS") // PLANNED, IN_PROGRESS, COMPLETED

  // Titres et résumés localisés
  titleFr       String
  titleEn       String?
  titleDe       String?
  summaryFr     String    @db.Text
  summaryEn     String?   @db.Text
  summaryDe     String?   @db.Text

  // Présentations détaillées (contexte & problème traité)
  descriptionFr String    @db.Text
  descriptionEn String?   @db.Text
  descriptionDe String?   @db.Text

  // Objectifs structurés multilingues
  objectivesFr  String?   @db.Text
  objectivesEn  String?   @db.Text
  objectivesDe  String?   @db.Text

  // Actions de mise en œuvre concrète sur le terrain
  actionsFr     String?   @db.Text
  actionsEn     String?   @db.Text
  actionsDe     String?   @db.Text

  // Résultats obtenus & indicateurs validés
  resultsFr     String?   @db.Text
  resultsEn     String?   @db.Text
  resultsDe     String?   @db.Text

  // Repères territoriaux & opérationnels
  location      String    // ex: Agbélouvé, Région Maritime, Togo
  country       String    @default("Togo")
  startDate     DateTime?
  endDate       DateTime?
  beneficiaries String?   // ex: 45 jeunes femmes diplômées (chiffre certifié uniquement)
  budget        String?

  // Image principale
  featuredImage String?
  gallery       String?   // JSON fallback legacy

  // Relations directes
  domaineId     String?
  domaine       Domaine?    @relation(fields: [domaineId], references: [id], onDelete: SetNull)
  ressources    Ressource[]
  medias        Media[]

  // Ordre et mise en avant (conservés obligatoirement)
  isFeatured    Boolean   @default(false)
  displayOrder  Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([publishedFr])
  @@index([publishedEn])
  @@index([publishedDe])
  @@index([isFeatured])
  @@index([domaineId])
}

// ─── 15. CMS : ÉVÉNEMENTS & FORMATIONS ────────────────────────────────────────

/// Cycle de vie d'une DEMANDE de participation.
/// Règle métier APTIC-R : une demande n'est pas une inscription.
/// Seul `APPROVED`, décidé par un humain après contact, consomme une place.
enum ParticipationRequestStatus {
  PENDING // demande reçue, en attente de contact par l'équipe
  APPROVED // participation confirmée → consomme une place
  REJECTED // demande refusée → ne consomme aucune place
  CANCELLED // participation annulée après validation → libère une place
}

/// Demande de participation à un événement, soumise depuis la page publique.
/// Le champ `Evenement.maxParticipants` reste la capacité saisie par
/// l'administrateur : il n'est JAMAIS décrémenté. Les places consommées se
/// déduisent du seul décompte des demandes `APPROVED`.
model DemandeParticipation {
  id     String @id @default(cuid())
  eventId String
  event   Evenement @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Demandeur
  firstName    String
  lastName     String
  email        String
  phone        String
  organization String?
  city         String?
  country      String?
  message      String? @db.Text
  lang         LanguageCode @default(FR)

  consentAt DateTime?

  status          ParticipationRequestStatus @default(PENDING)
  rejectionReason String?                      @db.Text
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewedByName  String?

  // Lecture par l'administrateur, distincte de la validation.
  // « Lue » ne veut pas dire « validée » : une demande peut être lue et rester
  // PENDING jusqu'à ce que l'administrateur clique sur « Valider ».
  readAt      DateTime?
  history     HistoriqueParticipation[]
  emailLogs   EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([eventId, status])
  @@index([eventId, email])
  @@index([readAt])
  @@index([eventId, readAt])
}

/// Journal des changements de statut d'une demande de participation.
/// Reprend le modèle `HistoriqueCandidature` : aucune demande n'est supprimée.
model HistoriqueParticipation {
  id        String             @id @default(cuid())
  requestId String
  request   DemandeParticipation @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fromStatus ParticipationRequestStatus?
  toStatus   ParticipationRequestStatus
  changedById String?
  changedByName String            @default("Système")
  note       String?             @db.Text
  changedAt  DateTime            @default(now())

  @@index([requestId])
}

model Evenement {
  id               String    @id @default(cuid())
  slug             String    @unique
  titleFr          String
  titleEn          String?
  titleDe          String?
  descriptionFr    String    @db.Text
  descriptionEn    String?   @db.Text
  descriptionDe    String?   @db.Text
  programmeFr      String?   @db.Text
  programmeEn      String?   @db.Text
  programmeDe      String?   @db.Text
  category         String    @default("WORKSHOP") // WORKSHOP, TRAINING, CONFERENCE, HACKATHON, CEREMONY, OTHER
  categoryOther    String? // libellé libre, obligatoire si category = OTHER
  location         String? // null pour un événement uniquement en ligne
  startDate        DateTime
  endDate          DateTime?
  isOnline         Boolean   @default(false)
  meetingUrl       String?
  registrationUrl  String? // formulaire externe OPTIONNEL : le canal principal est désormais la demande intégrée
  registrationOpen Boolean   @default(false) // ouverture des DEMANDES de participation
  maxParticipants  Int? // capacité MAXIMALE saisie par l'administrateur — jamais décrémentée
  demandes         DemandeParticipation[]
  featuredImage    String?
  contactName      String? // contact de l'événement, distinct du contact institutionnel
  contactEmail     String?
  contactPhone     String?
  published        Boolean   @default(false)
  publishedFr      Boolean   @default(false)
  publishedEn      Boolean   @default(false)
  publishedDe      Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([startDate])
  @@index([published])
  @@index([category])
  @@index([publishedFr])
  @@index([publishedEn])
  @@index([publishedDe])
}

// ─── 16. CMS : BIBLIOTHÈQUE DE RESSOURCES ─────────────────────────────────────
model Ressource {
  id            String       @id @default(cuid())
  titleFr       String
  titleEn       String?
  titleDe       String?
  descriptionFr String?      @db.Text
  descriptionEn String?      @db.Text
  descriptionDe String?      @db.Text
  type          String       @default("REPORT") // REPORT, GUIDE, PROJECT_SHEET, STATUTE, OTHER
  year          Int
  lang          LanguageCode @default(FR)
  fileUrl       String
  fileName      String
  fileSize      Int?         // Taille en octets ou Ko
  fileSizeStr   String?      // Format lisible ex: "2.4 Mo"
  mimeType      String?      @default("application/pdf")

  domaineId     String?
  domaine       Domaine?     @relation(fields: [domaineId], references: [id], onDelete: SetNull)

  projetId      String?
  projet        Projet?      @relation(fields: [projetId], references: [id], onDelete: SetNull)

  downloadCount Int          @default(0)
  published     Boolean      @default(true)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@index([year])
  @@index([lang])
  @@index([published])
  @@index([domaineId])
  @@index([projetId])
}

// ─── 17. CMS : GALERIE MÉDIAS & ALBUMS ────────────────────────────────────────
model Album {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleFr     String
  titleEn     String?
  titleDe     String?
  descriptionFr String? @db.Text
  descriptionEn String? @db.Text
  descriptionDe String? @db.Text
  coverImage  String?
  published   Boolean  @default(true)
  order       Int      @default(0)

  medias      Media[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([order])
  @@index([slug])
}

model Media {
  id           String   @id @default(cuid())
  titleFr      String
  titleEn      String?
  titleDe      String?
  captionFr    String?
  captionEn    String?
  captionDe    String?
  url          String
  thumbnailUrl String?
  type         String   @default("PHOTO") // PHOTO, VIDEO
  album        String?  // Legacy text name (kept for backwards compatibility)
  category     String?  // TERRAIN, ATELIER, EQUIPE, COMMUNAUTE
  order        Int      @default(0)
  featured     Boolean  @default(false)

  albumId      String?
  albumRel     Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)

  projetId     String?
  projet       Projet?  @relation(fields: [projetId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([album])
  @@index([albumId])
  @@index([category])
  @@index([featured])
  @@index([projetId])
}

// ─── 18. CMS : CATÉGORIES D'ÉQUIPE ──────────────────────────────────────────
model CategorieEquipe {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ─── 19. CMS : ÉQUIPE & GOUVERNANCE ───────────────────────────────────────────
model MembreEquipe {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  roleFr    String
  roleEn    String?
  roleDe    String?
  category  String   @default("COORDINATION") // DIRECTION, COORDINATION, FORMATION, CONSEIL, VOLONTAIRE
  bioFr     String   @db.Text
  bioEn     String?  @db.Text
  bioDe     String?  @db.Text
  photoUrl  String?
  email     String?
  linkedin  String?
  twitter   String?
  skills    String?  // JSON string array
  order     Int      @default(0)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([lastName])
  @@index([order])
  @@index([active])
}

// ─── 20. CMS : TÉMOIGNAGES ADMINISTRABLES ─────────────────────────────────────
model Temoignage {
  id         String   @id @default(cuid())
  authorName String
  authorRole String   // ex: "Bénéficiaire formation", "Volontaire 2024"
  authorType String   @default("VOLUNTEER") // BENEFICIARY, VOLUNTEER, PARTNER, TRAINER
  authorOrg  String?
  photoUrl   String?
  quoteFr    String   @db.Text
  quoteEn    String?  @db.Text
  quoteDe    String?  @db.Text
  rating     Int?     @default(5)
  featured   Boolean  @default(true)
  order      Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorType])
  @@index([featured])
  @@index([order])
}

// ─── 21. NEWSLETTER : ABONNÉS ─────────────────────────────────────────────────
model NewsletterAbonne {
  id             String       @id @default(cuid())
  email          String       @unique
  firstName      String?
  lang           LanguageCode @default(FR)
  active         Boolean      @default(true)
  consent        Boolean      @default(false)
  consentAt      DateTime?
  consentSource  String?
  consentVersion String?
  subscribedAt   DateTime     @default(now())
  unsubscribedAt DateTime?
  unsubscribeTokens NewsletterUnsubscribeToken[]
  newsletterCampaignDeliveries NewsletterCampagneDestinataire[]

  // Attribution UTM first-touch (indépendante du consentement Analytics)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  @@index([email])
  @@index([active])
}

model NewsletterUnsubscribeToken {
  id           String           @id @default(cuid())
  subscriberId String
  subscriber   NewsletterAbonne @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tokenHash    String           @unique
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())

  @@index([subscriberId])
}

model NewsletterCampagne {
  id           String       @id @default(cuid())
  name         String
  lang         LanguageCode @default(FR)
  status       String       @default("DRAFT") // Future statuses may represent scheduled/sent campaigns.
  subjectFr    String
  subjectEn    String
  subjectDe    String
  contentFr    String       @db.Text
  contentEn    String       @db.Text
  contentDe    String       @db.Text
  lastTestSentAt DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  totalRecipients Int       @default(0)
  sentCount    Int          @default(0)
  failedCount  Int          @default(0)
  deliveries   NewsletterCampagneDestinataire[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, updatedAt])
  @@index([lang])
}

model NewsletterCampagneDestinataire {
  id             String            @id @default(cuid())
  campaignId     String
  campaign       NewsletterCampagne @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId   String?
  subscriber     NewsletterAbonne? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  lang           LanguageCode
  status         String            @default("PENDING") // PENDING | SENDING | SENT | FAILED
  attempts       Int               @default(0)
  emailLogId     String?
  error          String?           @db.Text
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status, createdAt])
  @@index([subscriberId])
}

// ─── 22. CMS : PARAMÈTRES & MÉDIAS DU SITE ───────────────────────────────────
model ParametreSite {
  id          String   @id @default(cuid())
  key         String   @unique // ex: about_story_image, about_story_location, contact_email, contact_phone, contact_director
  value       String   @db.Text
  group       String   @default("GENERAL") // GENERAL, ABOUT, HOME, CONTACT, VOLUNTEER
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([group])
}

// ─── 23. MESSAGES DU FORMULAIRE DE CONTACT ────────────────────────────────────
enum MessageContactStatus {
  UNREAD     // Non lu
  READ       // Lu
  REPLIED    // Répondu
  ARCHIVED   // Archivé
}

model MessageContact {
  id           String               @id @default(cuid())
  name         String
  email        String
  organization String?
  phone        String?
  subject      String
  message      String               @db.Text
  routedTo     String?
  lang         LanguageCode         @default(FR)
  status       MessageContactStatus @default(UNREAD)

  // Attribution UTM first-touch (indépendante du consentement Analytics)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  notes        String?              @db.Text
  repliedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// ─── 24. LIENS UTM : CAMPAGNES CRÉÉES PAR L'ÉQUIPE ────────────────────────────
// Historique des liens de campagne générés depuis le back-office.
// Ne stocke aucune donnée personnelle : c'est un outil de création de liens,
// pas un outil de tracking des visiteurs (qui reste dans utm.ts).
model LienCampagne {
  id              String   @id @default(cuid())
  label           String                         // Nom humain : "Recrutement octobre 2026"
  destinationPath String                         // ex: /volontariat
  channel         String                         // facebook | instagram | linkedin | ...
  utmSource       String
  utmMedium       String
  utmCampaign     String                         // valeur normalisée (slug)
  utmContent      String?
  utmTerm         String?
  generatedUrl    String   @db.Text              // URL complète prête à l'emploi
  createdBy       String?                        // email de l'admin créateur (optionnel)

  // Compteur de clics (redirection suivie via /api/r/[id])
  clicks          Int      @default(0)
  lastClickedAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([utmCampaign])
  @@index([channel])
  @@index([createdAt])
}

model PropositionProjet {
  id              String   @id @default(cuid())
  referenceNumber String   @unique
  lang            LanguageCode @default(FR)
  proposerName    String
  organization    String?
  email           String
  country         String
  title           String
  domain          String
  description     String   @db.Text
  objectives      String   @db.Text
  targetAudience  String   @db.Text
  expectedResults String   @db.Text
  collaboration  String
  timeline        String
  budget          String?  @db.Text
  message         String?  @db.Text
  consent         Boolean  @default(false)
  status          String   @default("NOUVEAU")
  document        DocumentPropositionProjet?
  notes           DocumentPropositionNote[]
  statusHistory   HistoriquePropositionProjet[]
  convertedProject Projet?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model DocumentPropositionNote {
  id         String            @id @default(cuid())
  proposalId String
  proposal   PropositionProjet @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorId   String?
  author     Utilisateur?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  content    String            @db.Text
  createdAt  DateTime          @default(now())

  @@index([proposalId, createdAt])
  @@index([authorId])
}

model HistoriquePropositionProjet {
  id            String            @id @default(cuid())
  proposalId    String
  proposal      PropositionProjet @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  changedById   String?
  changedBy     Utilisateur?      @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedByName String
  createdAt     DateTime          @default(now())

  @@index([proposalId, createdAt])
  @@index([changedById])
}

model DocumentPropositionProjet {
  id           String           @id @default(cuid())
  proposalId   String           @unique
  proposal     PropositionProjet @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  createdAt    DateTime         @default(now())

  @@index([proposalId])
}
