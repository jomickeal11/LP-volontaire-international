{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/[lang]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]/admin",
      "regex": "^/([^/]+?)/admin(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/admin(?:/)?$"
    },
    {
      "page": "/[lang]/admin/analytics",
      "regex": "^/([^/]+?)/admin/analytics(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/admin/analytics(?:/)?$"
    },
    {
      "page": "/[lang]/admin/applications",
      "regex": "^/([^/]+?)/admin/applications(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/admin/applications(?:/)?$"
    },
    {
      "page": "/[lang]/admin/applications/[id]",
      "regex": "^/([^/]+?)/admin/applications/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/admin/applications/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]/admin/dashboard",
      "regex": "^/([^/]+?)/admin/dashboard(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/admin/dashboard(?:/)?$"
    },
    {
      "page": "/[lang]/admin/login",
      "regex": "^/([^/]+?)/admin/login(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/admin/login(?:/)?$"
    },
    {
      "page": "/[lang]/apply",
      "regex": "^/([^/]+?)/apply(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/apply(?:/)?$"
    },
    {
      "page": "/[lang]/partners",
      "regex": "^/([^/]+?)/partners(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/partners(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}