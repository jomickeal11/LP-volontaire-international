# Copiez ce fichier vers .env.development.local et renseignez les valeurs locales.
# Ne mettez jamais de vrais identifiants ici et ne publiez aucun autre fichier .env.

# PostgreSQL / Prisma. Utilisez une base locale ou une branche distincte de la production.
# DATABASE_URL est utilisée par l'application. DATABASE_URL_UNPOOLED est l'endpoint
# direct recommandé pour les migrations Prisma, si votre fournisseur le propose.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/apticr_development?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/apticr_development?schema=public"
NEON_BRANCH="development"

# Authentification. Générez une valeur aléatoire unique, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Facultatif : utilisé uniquement par scripts/seed-admin.ts pour créer ou mettre à jour
# un compte administrateur local. Utilisez un compte et un mot de passe dédiés au local.
ADMIN_EMAIL="admin@example.invalid"
ADMIN_INITIAL_PASSWORD=""

# URL publique de l'application. Les liens d'invitation, de réinitialisation et de
# confirmation d'adresse utilisent cette URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-mails transactionnels
# Resend est sélectionné explicitement. Laissez sa clé vide en développement local :
# les envois signaleront une erreur de configuration tant que la clé n'est pas définie.
# En production, validez le domaine d'expédition dans Resend et utilisez une adresse
# appartenant à ce domaine.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
MAIL_FROM="APTIC-R <noreply@example.com>"
MAIL_ADMIN=""

# Pour utiliser SMTP, remplacez EMAIL_PROVIDER par "smtp" et renseignez ces valeurs.
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASSWORD=""

# Paramètres facultatifs de Google Analytics et de Search Console.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_GA_ID=""
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Service de traduction facultatif. Laissez vide pour utiliser le comportement de repli.
DEEPL_API_KEY=""

# Nécessaire pour autoriser les tâches planifiées de nettoyage dans les environnements
# où elles sont exécutées. Générez une valeur distincte de NEXTAUTH_SECRET.
CRON_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET"

# L'application utilise les buckets Neon `documents` et `media` : ces variables
# doivent être renseignées pour les uploads et téléchargements. Pour tester le
# stockage en local, utilisez les valeurs d'une branche Neon de développement.
# L'endpoint ci-dessous est uniquement un emplacement local fictif.
AWS_ACCESS_KEY_ID="LOCAL_ONLY_REPLACE_WITH_NEON_BRANCH_KEY"
AWS_SECRET_ACCESS_KEY="LOCAL_ONLY_REPLACE_WITH_NEON_BRANCH_SECRET"
AWS_ENDPOINT_URL_S3="http://127.0.0.1:9000"
AWS_REGION="us-east-1"

# URL facultatives pour les vérifications rapides en local.
TEST_BASE_URL="http://localhost:3000"
PROBE_BASE="http://localhost:3000"
