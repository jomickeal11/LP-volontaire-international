# Template only. Every value below is fake and must be replaced locally.
# Never copy production values into this file or commit a *local env file.

# Neon/PostgreSQL. Use a non-production branch. Prisma currently reads only DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/apticr_development?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/apticr_development?schema=public"
NEON_BRANCH="development"

# Local session authentication
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_LOCAL_SECRET"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.invalid"
ADMIN_INITIAL_PASSWORD="FAKE_ONLY_CHANGE_BEFORE_ANY_SEED"

# Local URLs and public metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EMAIL_LOGO_URL="http://localhost:3000/logo-aptic-official.png"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_GA_ID=""

# Transactional email. Blank EMAIL_PROVIDER auto-selects Resend when its key is set;
# otherwise SMTP defaults to the Mailtrap sandbox. Set smtp or resend to force one.
EMAIL_PROVIDER="smtp"
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT="2525"
MAIL_USER="FAKE_LOCAL_SMTP_USER"
MAIL_PASSWORD="FAKE_LOCAL_SMTP_PASSWORD"
MAIL_FROM="APTIC-R Development <noreply@example.invalid>"
MAIL_ADMIN="developer@example.invalid"
RESEND_API_KEY="FAKE_NOT_A_VALID_RESEND_KEY"

# Neon Object Storage / S3-compatible storage. Local endpoint and fake credentials only.
AWS_ACCESS_KEY_ID="FAKE_LOCAL_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="FAKE_LOCAL_SECRET_KEY"
AWS_ENDPOINT_URL_S3="http://127.0.0.1:9000"
AWS_REGION="example-region-1"

# Optional external services; placeholders do not authenticate.
DEEPL_API_KEY="FAKE_NOT_A_VALID_DEEPL_KEY"
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL="service-account@example.invalid"
GA4_PRIVATE_KEY="FAKE_NOT_A_VALID_PRIVATE_KEY"
CRON_SECRET="REPLACE_WITH_A_RANDOM_LOCAL_SECRET"

# Optional local runtime probes
TEST_BASE_URL="http://localhost:3000"
PROBE_BASE="http://localhost:3000"

